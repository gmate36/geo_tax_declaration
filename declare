def detect_chrome():
    if sys.platform == "darwin":
        path = "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
        return [path] if os.path.exists(path) else None

    # 1. Поиск в PATH
    for name in ("google-chrome", "google-chrome-stable", "chromium-browser", "chromium"):
        p = shutil.which(name)
        if p:
            return [p]

    # 2. Поиск по стандартным каталогам дистрибутивов
    candidates = [
        "/opt/google/chrome/google-chrome",
        "/usr/bin/google-chrome",
        "/usr/bin/google-chrome-stable",
        "/usr/lib64/chromium-browser/chromium-browser",
    ]
    for p in candidates:
        if os.path.exists(p) and os.access(p, os.X_OK):
            return [p]

    # 3. Поддержка Flatpak (проброс host FS и сети для DevTools CDP)
    if shutil.which("flatpak"):
        try:
            r = subprocess.run(["flatpak", "list", "--app"], capture_output=True, text=True)
            for app_id in ("com.google.Chrome", "org.chromium.Chromium"):
                if app_id in r.stdout:
                    return ["flatpak", "run", "--filesystem=host", "--share=network", app_id]
        except Exception:
            pass

    return None


