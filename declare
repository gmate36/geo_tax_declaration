class Fail(Exception):
    pass


def say(text=""):
    print(text, flush=True)


def ask(prompt):
    sys.stdout.write(prompt)
    sys.stdout.flush()
    return sys.stdin.readline().strip()


def keychain_get(service):
    r = subprocess.run(["security", "find-generic-password", "-s", service], capture_output=True, text=True)
    if r.returncode != 0:
        return None, None
    account = re.search(r'"acct"<blob>="([^"]*)"', r.stdout)
    pwd = subprocess.run(["security", "find-generic-password", "-s", service, "-w"], capture_output=True, text=True)
    return (account.group(1) if account else None), pwd.stdout.strip()


def keychain_set(service, account, password):
    subprocess.run(["security", "add-generic-password", "-U", "-s", service, "-a", account, "-w", password],
                   check=True, capture_output=True)


def credentials(service, title, login_hint):
    account, password = keychain_get(service)
    if account and password:
        return account, password
    say(f"\n{title}: логин и пароль нужны один раз, дальше они лежат в Связке ключей ({service}).")
    account = ask(f"{login_hint}: ")
    password = getpass.getpass("Пароль: ")
    keychain_set(service, account, password)
    return account, password


class WS:
    def __init__(self, url, port):
        path = url.split(str(port), 1)[1]
        self.sock = socket.create_connection(("127.0.0.1", port), timeout=60)
        key = base64.b64encode(os.urandom(16)).decode()
        self.sock.sendall((f"GET {path} HTTP/1.1\r\nHost: 127.0.0.1:{port}\r\nUpgrade: websocket\r\n"
                           f"Connection: Upgrade\r\nSec-WebSocket-Key: {key}\r\n"
                           "Sec-WebSocket-Version: 13\r\n\r\n").encode())
        resp = b""
        while b"\r\n\r\n" not in resp:
            resp += self.sock.recv(4096)
        if b"101" not in resp.split(b"\r\n")[0]:
            raise Fail("Chrome не принял подключение отладчика")
        self.buf = resp.split(b"\r\n\r\n", 1)[1]

    def readable(self, timeout):
        return bool(self.buf) or bool(select.select([self.sock], [], [], timeout)[0])

    def _exact(self, n):
        while len(self.buf) < n:
            chunk = self.sock.recv(1 << 20)
            if not chunk:
                raise Fail("Chrome закрыл соединение")
            self.buf += chunk
        out, self.buf = self.buf[:n], self.buf[n:]
        return out

    def send(self, text):
        payload = text.encode()
        header = bytearray([0x81])
        mask = os.urandom(4)
        n = len(payload)
        if n < 126:
            header.append(0x80 | n)
        elif n < 65536:
            header.append(0x80 | 126)
            header += struct.pack(">H", n)
        else:
            header.append(0x80 | 127)
            header += struct.pack(">Q", n)
        self.sock.sendall(bytes(header) + mask + bytes(b ^ mask[i % 4] for i, b in enumerate(payload)))

    def recv(self):
        self._exact(1)
        length = self._exact(1)[0] & 0x7F
        if length == 126:
            length = struct.unpack(">H", self._exact(2))[0]
        elif length == 127:
            length = struct.unpack(">Q", self._exact(8))[0]
        return self._exact(length).decode("utf-8", "ignore")


class Browser:
    def __init__(self, debug_dir=None, visible=False):
        if not os.path.exists(CHROME):
            raise Fail("нужен Google Chrome в /Applications")
        os.makedirs(PROFILE, exist_ok=True)
        port_file = os.path.join(PROFILE, "DevToolsActivePort")
        if os.path.exists(port_file):
            os.remove(port_file)
        self.debug_dir = debug_dir
        mode = [] if visible else ["--headless=new", "--disable-gpu"]
        self.proc = subprocess.Popen(
            [CHROME, *mode, "--remote-debugging-port=0", "--remote-allow-origins=*",
             f"--user-data-dir={PROFILE}", "--no-first-run", "--no-default-browser-check",
             "--window-size=1400,1000", "about:blank"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        for _ in range(150):
            if os.path.exists(port_file):
                break
            if self.proc.poll() is not None:
                raise Fail("Chrome не запустился: возможно, профиль занят другим запуском declare")
            time.sleep(0.2)
        self.port = int(open(port_file).readline())
        ws_url = None
        for _ in range(80):
            try:
                targets = json.load(urllib.request.urlopen(f"http://127.0.0.1:{self.port}/json", timeout=5))
                pages = [t for t in targets if t.get("type") == "page"]
                if pages:
                    ws_url = pages[0]["webSocketDebuggerUrl"]
                    break
            except OSError:
                pass
            time.sleep(0.3)
        if not ws_url:
            raise Fail("Chrome не отдал вкладку")
        self.ws = WS(ws_url, self.port)
        self.seq = 0
        self.responses = {}
        self.send("Page.enable")
        self.send("Runtime.enable")

    def send(self, method, params=None, timeout=120):
        self.seq += 1
        mid = self.seq
        self.ws.send(json.dumps({"id": mid, "method": method, "params": params or {}}))
        deadline = time.time() + timeout
        while mid not in self.responses:
            if time.time() > deadline:
                raise Fail(f"Chrome не ответил на {method}")
            if self.ws.readable(0.25):
                self._handle(json.loads(self.ws.recv()))
        msg = self.responses.pop(mid)
        if "error" in msg:
            raise Fail(f"{method}: {msg['error'].get('message')}")
        return msg.get("result", {})

    def _handle(self, msg):
        if "id" in msg:
            self.responses[msg["id"]] = msg
        elif msg.get("method") == "Page.javascriptDialogOpening":
            self.seq += 1
            self.ws.send(json.dumps({"id": self.seq, "method": "Page.handleJavaScriptDialog",
                                     "params": {"accept": True}}))

    def pump(self, seconds):
        end = time.time() + seconds
        while time.time() < end:
            if self.ws.readable(min(0.2, max(0.0, end - time.time()))):
                self._handle(json.loads(self.ws.recv()))

    def js(self, expr, awaitp=False):
        r = self.send("Runtime.evaluate", {"expression": expr, "returnByValue": True, "awaitPromise": awaitp})
        if "exceptionDetails" in r:
            raise Fail("ошибка на странице: " + json.dumps(r["exceptionDetails"].get("exception", {}).get(
                "description", r["exceptionDetails"]))[:300])
        return r.get("result", {}).get("value")

    def go(self, url, wait=2.0):
        self.send("Page.navigate", {"url": url})
        self.pump(0.5)
        for _ in range(120):
            try:
                if self.js("document.readyState") == "complete":
                    break
            except Fail:
                pass
            self.pump(0.25)
        self.pump(wait)

    def url(self):
        return self.js("location.href")

    def wait(self, expr, timeout=30, what="страницу"):
        end = time.time() + timeout
        while time.time() < end:
            try:
                value = self.js(expr)
                if value:
                    return value
            except Fail:
                pass
            self.pump(0.5)
        raise Fail(f"не дождался: {what}")

    def type_into(self, selector, text):
        self.js(f"(()=>{{const e=document.querySelector({json.dumps(selector)});e.focus();e.select&&e.select()}})()")
        self.send("Input.insertText", {"text": text})

    def snap(self, name):
        if not self.debug_dir:
            return
        os.makedirs(self.debug_dir, exist_ok=True)
        data = self.send("Page.captureScreenshot", {"format": "png"})["data"]
        with open(os.path.join(self.debug_dir, f"{name}.png"), "wb") as f:
            f.write(base64.b64decode(data))

    def close(self):
        try:
            self.send("Browser.close", timeout=5)
        except Exception:
            pass
        try:
            self.proc.wait(timeout=10)
        except subprocess.TimeoutExpired:
            self.proc.kill()


