def garna_incomes(b, year, month, folder):
    raw = b.wait(GARNA_STORE, timeout=40, what="список поступлений Garna")
    incomes = []
    for tx in json.loads(raw):
        at = datetime.datetime.fromisoformat(tx["at"]).astimezone(TBILISI)
        if tx["type"] == GARNA_INCOMING and (at.year, at.month) == (year, month):
            incomes.append({"id": tx["id"], "usd": float(tx["amount"]), "date": at.date()})
    for inc in incomes:
        path = os.path.join(folder, f"garna-invoice-{inc['id']}.pdf")
        if os.path.exists(path):
            continue
        data = b.js('(async()=>{const n=document.querySelector("#__nuxt").__vue_app__.config.globalProperties.$nuxt;'
                    f'const r=await n.$http.getBlob("transactions/{inc["id"]}/invoice/",{{lang:"en"}});'
                    'const blob=r.data||r;return await new Promise(ok=>{const f=new FileReader();'
                    'f.onload=()=>ok(f.result);f.readAsDataURL(blob)})})()', awaitp=True)
        if not data or not data.startswith("data:application/pdf"):
            raise Fail(f"Garna не отдала инвойс {inc['id']}")
        with open(path, "wb") as f:
            f.write(base64.b64decode(data.split(",", 1)[1]))
        inc["invoice"] = path
    return incomes


def nbg_rate(day):
    url = ("https://nbg.gov.ge/gw/api/ct/monetarypolicy/currencies/en/json/?"
           + urllib.parse.urlencode({"currencies": "USD", "date": day.isoformat()}))
    with urllib.request.urlopen(urllib.request.Request(url, headers={"Accept": "application/json"}),
                                timeout=20) as r:
        data = json.load(r)
    if not data or not data[0].get("currencies"):
        raise Fail(f"НБГ не отдал курс на {day}")
    c = data[0]["currencies"][0]
    return c["rate"] / (c.get("quantity") or 1)


