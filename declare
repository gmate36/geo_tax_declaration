def garna_session(debug_dir):
    b = Browser(debug_dir)
    b.go(GARNA_PAGE, wait=3)
    if "/auth/" not in b.url():
        return b
    b.close()
    email, password = credentials("declare-garna", "Garna", "Почта для входа в Garna")
    say("Сейчас откроется окно Chrome с Garna: почта и пароль уже будут вписаны, введи код 2FA.")
    say("Окно закроется само. Повторять это придётся примерно раз в полгода.")
