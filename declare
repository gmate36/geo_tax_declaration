def rs_print(b, seq, path):
    p = json.dumps([{"name": "PRINT_ID", "value": 1}, {"name": "SEQ_NUM", "value": int(seq)}])
    p = p.replace('"', "@").replace("'", "@")
    url = "https://decl.rs.ge/print.ashx?p=" + urllib.parse.quote(p)
    data = b.js(f'(async()=>{{const r=await fetch({json.dumps(url)},{{credentials:"include"}});'
                'const buf=new Uint8Array(await r.arrayBuffer());let s="";for(let i=0;i<buf.length;i++)'
                's+=String.fromCharCode(buf[i]);return btoa(s)})()', awaitp=True)
    raw = base64.b64decode(data)
    if raw.startswith(b"%PDF"):
        with open(path, "wb") as f:
            f.write(raw)
        return
    b.go(url, wait=3)
    pdf = b.send("Page.printToPDF", {"printBackground": True, "preferCSSPageSize": True})["data"]
    with open(path, "wb") as f:
        f.write(base64.b64decode(pdf))


def keepz_link(tin, payer_name, note, amount):
    req = urllib.request.Request(PAY_URL, headers={"User-Agent": "Mozilla/5.0"})
    with urllib.request.urlopen(req, timeout=30) as r:
        html, action = r.read().decode("utf-8", "replace"), r.url
    fields = {}
    for m in re.finditer(r'<input[^>]*name="([^"]+)"[^>]*>', html):
        if 'type="submit"' in m.group(0):
            continue
        v = re.search(r'value="([^"]*)"', m.group(0))
        fields[m.group(1)] = v.group(1) if v else ""
    for m in re.finditer(r'<select name="([^"]+)".*?</select>', html, re.S):
        opts = re.findall(r'<option[^>]*value="([^"]*)"', m.group(0))
        fields[m.group(1)] = opts[0] if opts else ""
    fields.update({
        "PayerSaidentno_TextBox": tin, "PayerNameS_TextBox": payer_name, "PayerName_TextBox": payer_name,
        "AdditionalInfo_TextBox": note, "Amount_TextBox": f"{amount:.2f}",
        "Banks_DropDownList": "2", "Pay_ImageButton": "Pay",
    })
    opener = urllib.request.build_opener(urllib.request.HTTPCookieProcessor(http.cookiejar.CookieJar()))
    post = urllib.request.Request(action, data=urllib.parse.urlencode(fields).encode(), headers={
        "Content-Type": "application/x-www-form-urlencoded", "Referer": action, "User-Agent": "Mozilla/5.0"})
    with opener.open(post, timeout=45) as r:
        body = r.read().decode("utf-8", "replace")
    m = re.search(r"window\.open\('(https://app\.keepz\.me/[^']+)'", body)
    if not m:
        raise Fail("rs.ge не выдал ссылку на оплату")
    return m.group(1)


def previous_month():
    first = datetime.date.today().replace(day=1)
    last = first - datetime.timedelta(days=1)
    return last.year, last.month


def run(args):
    year, month = (int(x) for x in args.month.split("-")) if args.month else previous_month()
    label = f"{MONTHS[month - 1]} {year}"
    folder = os.path.join(OUT_ROOT, f"{year}-{month:02d}")
    os.makedirs(folder, exist_ok=True)
    debug_dir = os.path.join(folder, "debug") if args.debug else None

    say(f"Декларация за {label}\n")
    say("Garna: смотрю поступления...")
    b = garna_session(debug_dir)
    try:
        incomes = garna_incomes(b, year, month, folder)
        if not incomes:
            say(f"За {label} поступлений в Garna нет. Нулевую декларацию скрипт не подаёт.")
            return 0
        total_raw = 0.0
        for inc in incomes:
            inc["rate"] = nbg_rate(inc["date"])
            total_raw += inc["usd"] * inc["rate"]
            say(f"  {inc['date']}: ${inc['usd']:,.2f} x курс НБГ {inc['rate']:.4f}")
        income_gel = math.ceil(total_raw - 1e-9)
        tax = round(income_gel / 100, 2)
        say(f"  итого доход {income_gel} лари, налог 1% = {tax:.2f}\n")

        say("rs.ge: вход...")
        tin = rs_login(b)
        rs_read_mandatory(b)
        rs_english(b)
        rs_open_small_business(b)
        rows = rs_rows(b)
        sent = [r for r in rows if r["reg"]]
        payer = rs_payer_name(b, tin)

        if sent:
            seq = sent[0]["seq"]
            say(f"За {label} декларация уже подана (рег. {sent[0]['reg']}, налог {sent[0]['assessment']}).")
        else:
            draft = [r for r in rows if not r["reg"]]
            if draft:
                b.js(f'view_decl("{draft[0]["seq"]}","{SMALL_BUSINESS}")')
            else:
                rs_click_text(b, "new return")
            b.pump(4)
            seq = b.wait('(()=>{const m=document.body.innerText.match(/N:(\\d{6,})/);return m?m[1]:null})()',
                         what="номер декларации")
            period = rs_form_period(b)
            if period != f"{year}-{month:02d}":
                raise Fail(f"rs.ge открыл декларацию за {period}, а считаем {year}-{month:02d}")
            got = rs_fill(b, income_gel)
            b.snap("rs-form")
            say(f"К подаче за {label}:")
            say(f"  поле 20, доход за месяц: {got['20']:.2f}")
            say(f"  поле 15, с начала года: {got['15']:.2f}")
            say(f"  налог: {got['26']:.2f}")
            if got["20"] != income_gel or abs(got["26"] - tax) > 0.005:
                raise Fail("rs.ge посчитал не то, что ожидалось - ничего не отправляю")
            if args.dry_run:
                say("\n--dry-run: не отправляю, черновик оставлен сохранённым на rs.ge.")
                rs_click_text(b, "Save")
                b.pump(3)
                return 0
            if ask("Подать? [y/N] ").lower() != "y":
                rs_click_text(b, "Save")
                b.pump(3)
                say("Не подано, черновик сохранён на rs.ge.")
                return 0
            rs_click_text(b, "Next")
            b.pump(4)
            rs_click_text(b, "Send")
            b.pump(6)
            b.snap("rs-sent")
            rs_open_small_business(b)
            done = [r for r in rs_rows(b) if r["seq"] == seq and r["reg"]]
            if not done:
                raise Fail("после отправки декларация не появилась как поданная - проверь в кабинете rs.ge")
            say(f"Подано, регистрационный номер {done[0]['reg']}.")

        pdf = os.path.join(folder, f"declaration-{year}-{month:02d}.pdf")
        rs_print(b, seq, pdf)
        say(f"PDF декларации: {pdf}")
    except Fail:
        b.snap("error")
        raise
    finally:
        b.close()

    note = f"{tin} small business tax for {label}"
    say("\nОплата:")
    say(f"  сумма {tax:.2f} лари, назначение: {note}")
    if payer:
        say(f"  ссылка: {keepz_link(tin, payer, note, tax)}")
    say(f"\nВсё лежит в {folder}")
    return 0


def main():
    p = argparse.ArgumentParser(prog="declare", description="Месячная декларация малого бизнеса в Грузии из Garna")
    p.add_argument("--month", help="месяц в формате 2026-09, по умолчанию прошлый")
    p.add_argument("--dry-run", action="store_true", help="заполнить и сохранить черновик, не отправлять")
    p.add_argument("--debug", action="store_true", help="сохранять скриншоты шагов в папку месяца")
    args = p.parse_args()
    try:
        return run(args)
    except Fail as e:
        say(f"\nОшибка: {e}")
        return 1
    except KeyboardInterrupt:
        say("\nПрервано.")
        return 130


if __name__ == "__main__":
    sys.exit(main())
