def nbg_rate(currency, day):
    url = (
        "https://nbg.gov.ge/gw/api/ct/monetarypolicy/currencies/en/json/?"
        + urllib.parse.urlencode({"currencies": currency, "date": day.isoformat()})
    )
    with urllib.request.urlopen(
        urllib.request.Request(url, headers={"Accept": "application/json"}), timeout=20
    ) as r:
        data = json.load(r)
    if not data or not data[0].get("currencies"):
        raise Fail(f"НБГ не знает валюту {currency} или не отдал курс на {day}")
    c = data[0]["currencies"][0]
    return c["rate"] / (c.get("quantity") or 1)


MENU_CURRENCIES = ("USD", "EUR", "GBP")


def ask_currency():
    menu = "  ".join(f"{i}) {c}" for i, c in enumerate(MENU_CURRENCIES, 1))
    while True:
        answer = ask(f"Валюта: {menu}, или код другой валюты: ").upper()
        if answer.isdigit() and 1 <= int(answer) <= len(MENU_CURRENCIES):
            return MENU_CURRENCIES[int(answer) - 1]
        if re.fullmatch(r"[A-Z]{3}", answer):
            try:
                nbg_rate(answer, datetime.date.today())
                return answer
            except Fail:
                say(f"  НБГ не публикует курс {answer}")
                continue
        say("  нужна цифра из списка или трёхбуквенный код, например CHF")


def ask_amount(currency):
    while True:
        answer = ask(f"Сумма в {currency}: ").replace(" ", "").replace(",", ".")
        try:
            value = float(answer)
            if value > 0:
                return value
        except ValueError:
            pass
        say("  нужно число, например 4800 или 2907.13")


def ask_date(year, month):
    while True:
        answer = ask("Дата поступления денег (ДД.ММ, или ДД.ММ.ГГГГ): ").strip()
        m = re.fullmatch(r"(\d{1,2})\.(\d{1,2})(?:\.(\d{4}))?", answer)
        if m:
            try:
                d = datetime.date(int(m.group(3) or year), int(m.group(2)), int(m.group(1)))
            except ValueError:
                d = None
            if d and (d.year, d.month) == (year, month):
                return d
        say(f"  нужна дата в {MONTHS[month - 1]} {year}, например 25.{month:02d}")


def manual_incomes(year, month):
    say(f"Поступления за {MONTHS[month - 1]} {year}.")
    currency = ask_currency()
    incomes = []
    while True:
        amount = ask_amount(currency)
        day = ask_date(year, month)
        incomes.append({"currency": currency, "amount": amount, "date": day})
        if ask("Ещё поступление в этом месяце? [y/N] ").lower() != "y":
            return incomes


def rs_login(b):
    login, password = credentials("declare-rs.ge", "rs.ge", "Логин rs.ge")
    b.go(RS_LOGIN, wait=3)
    if "Login.aspx" not in b.url():
        return

    b.js(
        '(()=>{const t=[...document.querySelectorAll("input[type=text]")].filter(i=>i.offsetParent&&'
        '!/search/i.test(i.id+i.name));t[0].setAttribute("data-declare","login");'
        '[...document.querySelectorAll("input[type=password]")].filter(i=>i.offsetParent)[0]'
        '.setAttribute("data-declare","password")})()'
    )
    b.type_into('input[data-declare="login"]', login)
    b.type_into('input[data-declare="password"]', password)
    b.js('document.getElementById("btnLogin").click()')

    hint = (
        "security delete-generic-password -s declare-rs.ge"
        if sys.platform == "darwin"
        else f"удалите секцию в {CREDS_FILE}"
    )

    b.wait(
        '(()=>{const e=document.getElementById("smsText");return e&&e.offsetParent?1:0})()',
        timeout=25,
        what=f"запрос кода из SMS (если не пришёл — проверь логин/пароль: {hint})",
    )

    code = ""
    while not code:
        code = ask("rs.ge, код из SMS: ").strip()
        if not code:
            say("  код не может быть пустым, дождитесь SMS и введите цифры.")

    b.type_into("#smsText", code)
    b.pump(0.5)
    b.js('document.getElementById("btnSmsLogin").click()')

    end = time.time() + 35
    while time.time() < end:
        if "Login.aspx" not in b.url():
            return

        err = b.js(
            '(()=>{const el=document.getElementById("lblError")||document.querySelector(".error-message");'
            'return el&&el.offsetParent?(el.innerText||"").trim():null})()'
        )
        if err:
            b.snap("rs-login-error")
            raise Fail(f"rs.ge отклонил вход: {err}")

        b.pump(0.5)

    b.snap("rs-login-timeout")
    raise Fail("не дождался входа в кабинет rs.ge (таймаут после отправки SMS)")


